{
    "name": "orion/notify-rules",
    "description": "Rule-based Telegram notifications for Filament, configured from the admin panel.",
    "keywords": [
        "orion",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "notify-rules"
    ],
    "homepage": "https://github.com/gev-org-3/notify-rules",
    "support": {
        "issues": "https://github.com/gev-org-3/notify-rules/issues",
        "source": "https://github.com/gev-org-3/notify-rules"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Gevorg Manukyan",
            "email": "gevorgmanukyan349@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.10",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.16|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Orion\\NotifyRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orion\\NotifyRules\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "env": "@php -r \"copy(is_file('workbench/.env') ? 'workbench/.env' : 'workbench/.env.example', 'vendor/orchestra/testbench-core/laravel/.env');\"",
        "build": [
            "@env",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "poll": [
            "Composer\\Config::disableProcessTimeout",
            "@env",
            "@php vendor/bin/testbench notify-rules:poll --ansi"
        ],
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Orion\\NotifyRules\\NotifyRulesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
