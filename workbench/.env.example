APP_NAME="Notify Rules Workbench"
APP_ENV=local
APP_KEY=base64:bm90aWZ5LXJ1bGVzLXdvcmtiZW5jaC1rZXktMzJieXQ=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Create this database first (e.g. in HeidiSQL from Laragon).
DB_DATABASE=notify_rules_workbench
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Default currency for {{ field|money }} in templates.
NOTIFY_RULES_CURRENCY=RUB
LOG_CHANNEL=single

# Create a bot with @BotFather, then fill these in.
NOTIFY_RULES_TELEGRAM_BOT_TOKEN=
NOTIFY_RULES_TELEGRAM_BOT_USERNAME=
# Only needed for the webhook; polling (composer poll) works without it.
NOTIFY_RULES_TELEGRAM_WEBHOOK_SECRET=
